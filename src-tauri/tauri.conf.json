{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Leviathan",
  "version": "0.1.1",
  "identifier": "com.gitleviathan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Leviathan",
        "width": 1500,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#0e1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Cliente de Git local, sin cuentas ni telemetría",
    "longDescription": "Git Leviathan es un cliente de Git de escritorio que usa el binario git del sistema y respeta toda tu configuración. Sin login, sin nube y sin telemetría.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
